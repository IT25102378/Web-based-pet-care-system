# =============================================================================
# Pet Nexus Backend - Local Environment Configuration Template
# Copy this file to .env or set these environment variables in your local OS/IDE
# NEVER commit the actual .env file or credentials to version control!
# =============================================================================

# Centralized SQL Server Database
# Default: connects to local SQL Server instance using Windows Integrated Security
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=PetNexus;encrypt=true;trustServerCertificate=true;integratedSecurity=true

# Frontend Base URL (used for verification link generation)
FRONTEND_URL=http://localhost:3000

# Gmail SMTP Configuration for Email Verification
# 1. MAIL_HOST: smtp.gmail.com
# 2. MAIL_PORT: 587
# 3. MAIL_USERNAME: Your Google/Gmail address (e.g. yourname@gmail.com)
# 4. MAIL_PASSWORD: A Google "App Password" generated from:
#    Google Account -> Security -> 2-Step Verification -> App Passwords
#    (Note: Do NOT use your regular Google account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
